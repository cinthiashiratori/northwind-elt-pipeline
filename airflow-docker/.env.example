# Copy this file to .env and set your own values. Never commit .env.
# Passwords used inside URLs must be URL-safe (letters, digits, - and _).

# Linux / Codespaces only: output of `id -u` (leave unset on macOS / Windows)
# AIRFLOW_UID=50000

# Airflow metadata database
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me
AIRFLOW_DB_NAME=airflow

# Airflow web UI admin user
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=change_me

# Secret used to sign API tokens (generate one: openssl rand -hex 32)
AIRFLOW__API_AUTH__JWT_SECRET=change_me

# Destination (final) database
FINAL_DB_USER=final_user
FINAL_DB_PASSWORD=change_me
FINAL_DB_NAME=northwind_final

# Source database credentials read by Meltano tap-postgres.
# Must match NORTHWIND_USER / NORTHWIND_PASSWORD in source/.env
TAP_POSTGRES_USER=northwind_user
TAP_POSTGRES_PASSWORD=change_me
